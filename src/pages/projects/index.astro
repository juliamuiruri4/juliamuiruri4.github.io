---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<BaseLayout title="Projects | Julia Muiruri" pathname="/projects/">
	<div class="page-header">
		<h1 class="page-header__title">Projects</h1>
		<p class="page-header__desc">Demos, productivity tools and projects (Open-source).</p>
	</div>

	<div class="project-grid">
		{projects.map((project) => (
			<a class="project-card" href={`/projects/${project.id}/`}>
				<div class="project-card__header">
					<span class="project-card__title">{project.data.title}</span>
					<span class="project-card__year">{project.data.year}</span>
				</div>
				<p class="project-card__summary">{project.data.summary}</p>
				<div class="project-card__meta">
					{project.data.stack.map((tech) => (
						<span class="tag">{tech}</span>
					))}
				</div>
			</a>
		))}
	</div>
</BaseLayout>